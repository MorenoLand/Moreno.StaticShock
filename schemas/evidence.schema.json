{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/static-shock/evidence.schema.json",
  "title": "Evidence record",
  "type": "object",
  "required": ["claim", "confidence", "authority", "evidence"],
  "properties": {
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "The exact statement being supported, not a topic."
    },
    "confidence": {
      "type": "string",
      "enum": ["observed", "derived", "inferred"],
      "description": "observed: directly read or executed; derived: follows from recorded observations; inferred: a judgement that needs a test."
    },
    "authority": {
      "type": "string",
      "enum": [
        "shipped-artifact",
        "controlled-replay",
        "historical-reference",
        "external-service",
        "analyst-inference"
      ],
      "description": "Where the support comes from."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "location"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["pe-bytes", "ida-export", "ghidra-export", "disassembly", "trace", "capture", "test", "screenshot", "specification", "note"]
          },
          "location": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "object", "required": ["kind", "address"], "properties": { "kind": { "const": "address" }, "address": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["kind", "start", "end"], "properties": { "kind": { "const": "address-range" }, "start": { "type": "string" }, "end": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["kind", "path"], "properties": { "kind": { "const": "artifact-path" }, "path": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "required": ["kind", "offset"], "properties": { "kind": { "const": "file-offset" }, "offset": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }
        ]
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["complete", "partial", "unknown"] },
        "note": { "type": "string" }
      },
      "required": ["status"]
    }
  },
  "additionalProperties": false
}
